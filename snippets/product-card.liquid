<article class="product-card"><a href="{{ product.url }}" class="product-card__image">{% if product.compare_at_price > product.price %}<span class="badge">Sale</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title, widths: '320,480,800' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a><div class="product-card__details"><p class="eyebrow">{{ product.vendor }}</p><h3><a href="{{ product.url }}">{{ product.title }}</a></h3>{% render 'price', product: product %}</div></article>
