<aside class="cart-drawer" data-cart-drawer aria-label="Shopping cart" aria-hidden="true"><div class="cart-drawer__head"><h2>Your cart</h2><button class="icon-button" data-cart-close aria-label="Close cart">×</button></div><div data-cart-items>{% if cart.item_count == 0 %}<p>Your cart is empty.</p>{% else %}{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: item.title }}</a><div><a href="{{ item.url }}">{{ item.product.title }}</a><p>{{ item.quantity }} × {{ item.final_price | money }}</p></div></div>{% endfor %}{% endif %}</div><div class="cart-drawer__foot" data-cart-footer>{% if cart.item_count > 0 %}<p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><a class="button" href="{{ routes.cart_url }}">Checkout</a>{% endif %}</div></aside><div class="drawer-overlay" data-drawer-overlay hidden></div>
