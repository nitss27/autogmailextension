{
  "manifest_version": 3,
  "name": "Form Capture + ChatGPT Autofill",
  "version": "2.0.0",
  "description": "Capture current page source and required fields, send to ChatGPT, then autofill form fields from returned mappings.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Form Capture + ChatGPT Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
