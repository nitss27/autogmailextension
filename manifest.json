{
  "manifest_version": 3,
  "name": "Bulk Email Extractor",
  "description": "Sequential active-tab extraction of emails from main and contact/about pages.",
  "version": "1.2.0",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Domain Email Harvester",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}