{
  "manifest_version": 3,
  "name": "Domain Email Harvester",
  "description": "Opens websites in batches, extracts emails from DOM/source/contact pages, and copies a domain/email table.",
  "version": "1.1.0",
  "permissions": ["storage", "clipboardWrite", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Domain Email Harvester",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
