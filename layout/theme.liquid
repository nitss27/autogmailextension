<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>{{ content_for_header }}{{ settings.type_heading_font | font_face }}{{ settings.type_body_font | font_face }}{{ 'theme.css' | asset_url | stylesheet_tag }}<script src="{{ 'theme.js' | asset_url }}" defer></script><style>:root{--navy:{{ settings.color_primary }};--text:{{ settings.color_text }};--sale:{{ settings.color_sale }};--bg:{{ settings.color_background }};--cream:{{ settings.color_cream }};--heading:{{ settings.type_heading_font.family }},serif;--body:{{ settings.type_body_font.family }},sans-serif}</style></head><body><a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>{% sections 'header-group' %}<main id="MainContent" role="main">{{ content_for_layout }}</main>{% sections 'footer-group' %}{% render 'cart-drawer' %}</body></html>
