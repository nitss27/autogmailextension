<section class="section-padding"><div class="page-width narrow"><h1>Cart</h1>{% form 'cart', cart %}{% if cart.item_count > 0 %}{% for item in cart.items %}<div class="cart-line">{{ item.image | image_url: width: 120 | image_tag: alt: item.title }}<div><a href="{{ item.url }}">{{ item.title }}</a><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"> {{ item.final_line_price | money }}</div></div>{% endfor %}<p>Subtotal: {{ cart.total_price | money }}</p><button class="button" name="checkout">Checkout</button>{% else %}<p>Your cart is empty.</p><a href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% endif %}{% endform %}</div></section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
