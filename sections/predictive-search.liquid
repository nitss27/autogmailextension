{% if predictive_search.performed %}
  <div class="predictive-search-results" role="status">
    {% if predictive_search.resources.products.size > 0 %}
      <ul role="list">
        {% for product in predictive_search.resources.products %}
          <li><a href="{{ product.url }}">{{ product.title }}</a></li>
        {% endfor %}
      </ul>
    {% else %}
      <p>{{ section.settings.empty_text }}</p>
    {% endif %}
  </div>
{% endif %}
{% schema %}
{"name":"Predictive search","settings":[{"type":"text","id":"empty_text","label":"No results text","default":"No products found."}]}
{% endschema %}
