<section class="section-padding" id="FeaturedCollection-{{ section.id }}"><div class="page-width"><div class="section-heading"><h2>{{ section.settings.heading }}</h2>{% if section.settings.collection %}<a href="{{ section.settings.collection.url }}">View all</a>{% endif %}</div><div class="product-grid product-grid--{{ section.settings.columns }}">{% for product in section.settings.collection.products limit: section.settings.product_limit %}{% render 'product-card', product: product %}{% else %}{% for i in (1..section.settings.columns) %}<article class="product-card">{{ 'product-' | append: i | placeholder_svg_tag }}</article>{% endfor %}{% endfor %}</div></div></section>{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured collection"},{"type":"collection","id":"collection","label":"Collection"},{"type":"select","id":"columns","label":"Products per row","default":"4","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}]},{"type":"range","id":"product_limit","label":"Products to show","min":2,"max":12,"step":1,"default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}
