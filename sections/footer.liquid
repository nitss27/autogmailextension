<footer class="footer"><div class="page-width footer__grid"><div><h2>{{ section.settings.brand_heading | default: shop.name }}</h2><div>{{ section.settings.brand_text }}</div><p>{{ settings.address }}<br><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p></div><div><h3>{{ section.settings.policies_heading }}</h3>{% for link in section.settings.policies.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div><div><h3>{{ section.settings.links_heading }}</h3>{% for link in section.settings.quick_links.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div><div><h3>{{ section.settings.newsletter_heading }}</h3><div>{{ section.settings.newsletter_text }}</div>{% form 'customer', id: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Email address</label><input id="NewsletterEmail" type="email" name="contact[email]" required placeholder="Email address">{% if form.errors %}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}<button class="button" type="submit">Subscribe</button>{% if form.posted_successfully? %}<p>Thank you for subscribing.</p>{% endif %}{% endform %}<p class="socials">{% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram">Instagram</a>{% endif %}{% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook">Facebook</a>{% endif %}</p></div></div></footer>{% schema %}{"name":"Footer","settings":[{"type":"text","id":"brand_heading","label":"Brand heading","default":"LUXINOM"},{"type":"richtext","id":"brand_text","label":"Brand text","default":"<p>Timeless essentials for your everyday.</p>"},{"type":"text","id":"policies_heading","label":"Policies heading","default":"Policies"},{"type":"link_list","id":"policies","label":"Policies menu"},{"type":"text","id":"links_heading","label":"Quick links heading","default":"Quick links"},{"type":"link_list","id":"quick_links","label":"Quick links menu"},{"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Stay in the know"},{"type":"richtext","id":"newsletter_text","label":"Newsletter text","default":"<p>New arrivals and considered updates, delivered occasionally.</p>"},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"url","id":"facebook_url","label":"Facebook URL"}],"presets":[{"name":"Footer"}]}{% endschema %}
