<section class="hero" style="--overlay:{{ section.settings.overlay | times: 0.01 }};{% if section.settings.image %}--hero-image:url('{{ section.settings.image | image_url: width: 2400 }}'){% endif %}"><div class="page-width hero__content"><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p>{% if section.settings.button_label != blank %}<a class="button button--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></section>
{% schema %}{"name":"Hero banner","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"range","id":"overlay","label":"Overlay opacity","min":0,"max":90,"step":5,"default":30,"unit":"%"},{"type":"text","id":"heading","label":"Heading","default":"Everyday luxury, thoughtfully made"},{"type":"text","id":"subheading","label":"Subheading","default":"Discover pieces designed to make the everyday exceptional."},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Hero banner"}]}{% endschema %}
