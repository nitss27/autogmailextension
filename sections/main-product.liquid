{% assign current_variant = product.selected_or_first_available_variant %}
<section
  class="main-product section-padding"
  data-product
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}.js"
  data-cart-drawer-url="{{ routes.root_url }}?section_id=cart-drawer"
  data-in-stock-text="{{ section.settings.in_stock_text | escape }}"
  data-out-of-stock-text="{{ section.settings.out_stock_text | escape }}"
  data-add-text="{{ section.settings.add_to_cart_text | escape }}"
  data-sold-out-text="{{ section.settings.sold_out_text | escape }}"
  data-add-error-text="{{ section.settings.add_error_text | escape }}"
>
  <div class="page-width product-layout">
    <div class="product-gallery">
      <div class="gallery-thumbnails" aria-label="{{ section.settings.gallery_label | escape }}">
        {% for media in product.media %}
          {% if media.media_type == 'image' %}
            <button class="gallery-thumb{% if media.id == current_variant.featured_media.id or forloop.first %} is-active{% endif %}" type="button" data-media-id="{{ media.id }}" aria-label="{{ section.settings.view_media_label }} {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
      <div class="gallery-main" data-gallery-main>
        {% if current_variant.featured_media %}
          {{ current_variant.featured_media.preview_image | image_url: width: 1500 | image_tag: alt: current_variant.featured_media.alt | default: product.title, widths: '600,900,1500' }}
        {% elsif product.featured_media %}
          {{ product.featured_media.preview_image | image_url: width: 1500 | image_tag: alt: product.featured_media.alt | default: product.title, widths: '600,900,1500' }}
        {% endif %}
      </div>
    </div>

    <div class="product-info">
      {% if product.vendor != blank %}<p class="eyebrow">{{ product.vendor }}</p>{% endif %}
      <h1>{{ product.title }}</h1>
      <div data-price>{% render 'price', product: current_variant %}</div>
      <p class="tax-note">{% if cart.taxes_included %}{{ section.settings.tax_included_text }}{% else %}{{ section.settings.tax_checkout_text }}{% endif %}</p>

      {% assign form_id = 'ProductForm-' | append: section.id %}
      {% form 'product', product, id: form_id, data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="variant-picker">
              <legend>{{ option.name }}</legend>
              <div class="variant-picker__values">
                {% for value in option.values %}
                  <button type="button" class="variant-option{% if option.selected_value == value %} is-selected{% endif %}" data-option-position="{{ option.position }}" data-option-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}

        <ul class="product-benefits" role="list">
          <li>{% render 'icon-shipping' %} {{ section.settings.shipping_text }}</li>
          <li>{% render 'icon-support' %} {{ section.settings.support_text }}</li>
          <li>{% render 'icon-returns' %} {{ section.settings.returns_text }}</li>
          <li data-stock-status><span class="stock-dot{% if current_variant.available %} stock-dot--in{% endif %}"></span>{% if current_variant.available %}{{ section.settings.in_stock_text }}{% else %}{{ section.settings.out_stock_text }}{% endif %}</li>
        </ul>

        <div class="quantity">
          <label for="Quantity-{{ section.id }}">{{ section.settings.quantity_label }}</label>
          <button type="button" data-quantity-minus aria-label="{{ section.settings.decrease_label }}">−</button>
          <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" {% if current_variant.inventory_management and current_variant.inventory_policy == 'deny' %}max="{{ current_variant.inventory_quantity }}"{% endif %}>
          <button type="button" data-quantity-plus aria-label="{{ section.settings.increase_label }}">+</button>
        </div>
        <button type="submit" class="button button--full" data-add-button {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ section.settings.add_to_cart_text }}{% else %}{{ section.settings.sold_out_text }}{% endif %}</button>
        <p class="form-error" data-product-error hidden role="alert"></p>
      {% endform %}
      <div class="product-description rte">{{ product.description }}</div>
    </div>
  </div>
  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

{% schema %}
{"name":"Main product","settings":[{"type":"text","id":"gallery_label","label":"Gallery label","default":"Product media"},{"type":"text","id":"view_media_label","label":"View media label","default":"View image"},{"type":"text","id":"shipping_text","label":"Shipping benefit","default":"Free shipping"},{"type":"text","id":"support_text","label":"Support benefit","default":"Customer support"},{"type":"text","id":"returns_text","label":"Returns benefit","default":"7 day returns"},{"type":"text","id":"in_stock_text","label":"In stock text","default":"In stock"},{"type":"text","id":"out_stock_text","label":"Out of stock text","default":"Out of stock"},{"type":"text","id":"tax_included_text","label":"Tax included text","default":"Tax included."},{"type":"text","id":"tax_checkout_text","label":"Tax checkout text","default":"Taxes calculated at checkout."},{"type":"text","id":"quantity_label","label":"Quantity label","default":"Quantity"},{"type":"text","id":"decrease_label","label":"Decrease quantity label","default":"Decrease quantity"},{"type":"text","id":"increase_label","label":"Increase quantity label","default":"Increase quantity"},{"type":"text","id":"add_to_cart_text","label":"Add to cart text","default":"Add to cart"},{"type":"text","id":"sold_out_text","label":"Sold out text","default":"Sold out"},{"type":"text","id":"add_error_text","label":"Add to cart error text","default":"Unable to add this item to your cart."}],"presets":[{"name":"Main product"}]}
{% endschema %}
