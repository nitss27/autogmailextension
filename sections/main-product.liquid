<section class="main-product section-padding" data-product data-product-url="{{ product.url }}"><div class="page-width product-layout"><div class="product-gallery"><div class="gallery-thumbnails" aria-label="Product media">{% for media in product.media %}<button class="gallery-thumb{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" aria-label="View media {{ forloop.index }}">{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}</button>{% endfor %}</div><div class="gallery-main" data-gallery-main>{% if product.featured_media %}{{ product.featured_media.preview_image | image_url: width: 1500 | image_tag: alt: product.featured_media.alt | default: product.title, widths: '600,900,1500' }}{% endif %}</div></div><div class="product-info"><p class="eyebrow">{{ product.vendor }}</p><h1>{{ product.title }}</h1><div data-price>{% render 'price', product: product.selected_or_first_available_variant %}</div><p class="tax-note">{% if cart.taxes_included %}Tax included.{% else %}Taxes calculated at checkout.{% endif %}</p>{% form 'product', product, id: 'ProductForm-' | append: section.id, data-product-form: '' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<fieldset class="variant-picker"><legend>{{ option.name }}</legend><div>{% for value in option.values %}<button type="button" class="variant-option{% if option.selected_value == value %} is-selected{% endif %}" data-option-position="{{ option.position }}" data-option-value="{{ value | escape }}">{{ value }}</button>{% endfor %}</div></fieldset>{% endfor %}{% endunless %}<ul class="product-benefits"><li>{% render 'icon-shipping' %} {{ section.settings.shipping_text }}</li><li>{% render 'icon-support' %} {{ section.settings.support_text }}</li><li>{% render 'icon-returns' %} {{ section.settings.returns_text }}</li><li data-stock-status>{% if product.selected_or_first_available_variant.available %}<span class="stock-dot stock-dot--in"></span>{{ section.settings.in_stock_text }}{% else %}<span class="stock-dot"></span>{{ section.settings.out_stock_text }}{% endif %}</li></ul><div class="quantity"><label for="Quantity-{{ section.id }}">Quantity</label><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" max="{{ product.selected_or_first_available_variant.inventory_quantity | default: 999 }}"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div><button type="submit" class="button button--full" data-add-button {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</button><p class="form-error" data-product-error hidden></p>{% endform %}<div class="product-description">{{ product.description }}</div></div></div><script type="application/json" data-product-json>{{ product | json }}</script></section>{% schema %}{"name":"Main product","settings":[{"type":"text","id":"shipping_text","label":"Shipping benefit","default":"Free shipping"},{"type":"text","id":"support_text","label":"Support benefit","default":"Customer support"},{"type":"text","id":"returns_text","label":"Returns benefit","default":"7 day returns"},{"type":"text","id":"in_stock_text","label":"In stock text","default":"In stock"},{"type":"text","id":"out_stock_text","label":"Out of stock text","default":"Out of stock"}],"presets":[{"name":"Main product"}]}{% endschema %}
