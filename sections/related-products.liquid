<section class="related-products section-padding" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"><div class="page-width"><h2>{{ section.settings.heading }}</h2>{% if recommendations.performed and recommendations.products_count > 0 %}<div class="product-grid product-grid--{{ section.settings.columns }}">{% for product in recommendations.products %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}</div></section>{% schema %}{"name":"Related products","settings":[{"type":"text","id":"heading","label":"Heading","default":"You may also like"},{"type":"select","id":"columns","label":"Products per row","default":"4","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}]},{"type":"range","id":"limit","label":"Maximum products","min":2,"max":10,"step":1,"default":4}],"presets":[{"name":"Related products"}]}{% endschema %}
