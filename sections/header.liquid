<header data-predictive-url="{{ routes.predictive_search_url }}" class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}"><div class="page-width header"><button class="icon-button mobile-only" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu">☰<span class="visually-hidden">Menu</span></button><a class="header__brand" href="{{ routes.root_url }}">{% if section.settings.logo %}{{ section.settings.logo | image_url: width: 500 | image_tag: alt: shop.name, widths: '160,250,500' }}{% else %}{{ section.settings.logo_text | default: shop.name }}{% endif %}</a><nav class="header__nav" aria-label="Main navigation">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><div class="header__actions"><button class="icon-button" data-search-toggle aria-label="Search">⌕</button>{% if shop.customer_accounts_enabled %}<a class="icon-button desktop-account" href="{{ routes.account_url }}" aria-label="Account">♙</a>{% endif %}<button class="icon-button cart-toggle" aria-label="Cart, {{ cart.item_count }} items">♧<span class="cart-count" data-cart-count>{{ cart.item_count }}</span></button></div></div><div id="MobileMenu" class="mobile-menu" hidden>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div><div class="search-drawer" data-search-drawer hidden><form action="{{ routes.search_url }}" role="search"><label class="visually-hidden" for="SearchInput">Search</label><input id="SearchInput" name="q" type="search" placeholder="Search products" autocomplete="off" data-predictive-search><button>Search</button></form><div data-search-results></div></div></header>
{% schema %}{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo image"},{"type":"text","id":"logo_text","label":"Logo text fallback","default":"LUXINOM"},{"type":"link_list","id":"menu","label":"Main menu"},{"type":"checkbox","id":"sticky","label":"Enable sticky header","default":true}],"presets":[{"name":"Header"}]}{% endschema %}
