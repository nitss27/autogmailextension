{% if section.settings.show %}<section class="announcement" style="--announcement-bg:{{ section.settings.background }}" data-announcement {% if section.settings.dismissible %}data-dismissible{% endif %}><div class="page-width announcement__inner">{% for block in section.blocks %}<p {{ block.shopify_attributes }}>{{ block.settings.text }}</p>{% endfor %}</div>{% if section.settings.dismissible %}<button class="announcement__close" aria-label="Close announcement">×</button>{% endif %}</section>{% endif %}
{% schema %}{"name":"Announcement bar","class":"section-announcement","settings":[{"type":"checkbox","id":"show","label":"Show announcement bar","default":true},{"type":"color","id":"background","label":"Background","default":"#5A7C99"},{"type":"checkbox","id":"dismissible","label":"Allow customers to dismiss","default":true}],"blocks":[{"type":"announcement","name":"Announcement","settings":[{"type":"text","id":"text","label":"Text","default":"Free shipping on orders over Rs. 999"}]}],"max_blocks":3,"presets":[{"name":"Announcement bar","blocks":[{"type":"announcement"},{"type":"announcement","settings":{"text":"Easy 7 day returns"}},{"type":"announcement","settings":{"text":"Customer support every day"}}]}]}{% endschema %}
